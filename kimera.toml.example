# Copy to kimera.toml (here or next to kimera.exe) and adjust the paths.
# Single-quoted strings keep Windows backslashes as they are.

[lightcraft]
cli = 'F:\LightCraft\lightcraft-cli.exe'
# A running `lightcraft --control 7980`.
control = "127.0.0.1:7980"

[photocraft]
cli = 'F:\PhotoCraft\photocraft-cli.exe'

[vectorcraft]
cli = 'C:\Program Files\VectorCraft\vectorcraft-cli.exe'

[work]
# Each pipeline run writes to its own run-<time> folder in here.
dir = 'F:\pipeline'

[ai]
# Who turns a request ("remove the pimples and give it a film look") into a recipe:
# "anthropic" or "openai" (API key in ANTHROPIC_API_KEY / OPENAI_API_KEY),
# or "claude-code" / "codex" (the CLIs signed in on this computer).
provider = "anthropic"
# model = "claude-opus-5-5"
# api_key_env = "ANTHROPIC_API_KEY"
